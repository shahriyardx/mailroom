# Coolify: paste these as environment variables on the service.
# Everything here is secret except the two public URLs.

# --- Postgres ---
# Coolify's own Postgres service gives you an internal hostname.
DATABASE_URL="postgres://mail:CHANGEME@mail-postgres:5432/mail"

# --- better-auth ---
BETTER_AUTH_SECRET="openssl rand -base64 32"
BETTER_AUTH_URL="https://mail.shahriyar.dev"
NEXT_PUBLIC_APP_URL="https://mail.shahriyar.dev"

# --- Amazon SES ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_CONFIGURATION_SET="mail-events"
SES_SNS_TOPIC_ARN="arn:aws:sns:us-east-1:160885268543:mail-events"
SES_DKIM_SELECTOR="mail"
SES_MAIL_FROM_PREFIX="mail"

# --- inbound worker -> app shared secret ---
INBOUND_WEBHOOK_SECRET=""

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="mail-attachments"

# Set to "false" to apply migrations yourself instead of on boot.
RUN_MIGRATIONS_ON_BOOT="true"
