{
  "name": "mailroom",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted email for a company: send through SES, receive through Cloudflare, read it in a browser.",
  "keywords": [
    "email",
    "self-hosted",
    "ses",
    "smtp",
    "mailbox",
    "transactional-email",
    "cloudflare-email-routing"
  ],
  "homepage": "https://mailroom-docs.shahriyar.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahriyardx/mailroom.git"
  },
  "bugs": {
    "url": "https://github.com/shahriyardx/mailroom/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Md Shahriyar Alam <mdshahriyaralam552@gmail.com>",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/bundle-worker.mjs && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "better-auth generate --config src/lib/auth.ts",
    "worker:dev": "pnpm --filter mailroom-worker run dev",
    "worker:deploy": "pnpm --filter mailroom-worker run deploy",
    "worker:tail": "pnpm --filter mailroom-worker run tail",
    "ses:status": "node scripts/ses-status.mjs",
    "ses:setup": "node scripts/ses-setup-events.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "reset-owner": "node scripts/reset-owner.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "worker:bundle": "node scripts/bundle-worker.mjs",
    "sdk:build": "pnpm --filter @shahriyardx/mailroom run build",
    "sdk:test": "pnpm --filter @shahriyardx/mailroom run test",
    "sdk:typecheck": "pnpm --filter @shahriyardx/mailroom run typecheck",
    "docs:dev": "pnpm --filter mailroom-docs run dev",
    "docs:build": "pnpm --filter mailroom-docs run build",
    "docs:deploy": "pnpm --filter mailroom-docs run build && pnpm --filter mailroom-docs run deploy",
    "ext:dev": "pnpm --filter mailroom-extension run dev",
    "ext:build": "pnpm --filter mailroom-extension run build:all",
    "ext:zip": "pnpm --filter mailroom-extension run zip:all",
    "ext:typecheck": "pnpm --filter mailroom-extension run typecheck",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.1136.0",
    "@aws-sdk/client-sns": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@bprogress/next": "^3.2.12",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/view": "^6.43.12",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.62.0",
    "@uiw/react-codemirror": "^4.25.11",
    "better-auth": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
