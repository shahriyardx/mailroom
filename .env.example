# --- Postgres ---
DATABASE_URL="postgres://mail:mail@localhost:5432/mail"

# --- better-auth ---
BETTER_AUTH_SECRET="run: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Amazon SES (outbound) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional: SES configuration set that publishes events to SNS.
SES_CONFIGURATION_SET=""
# Pins the SNS topic allowed to post delivery events.
SES_SNS_TOPIC_ARN=""
# Prefix for the custom MAIL FROM subdomain: mail -> mail.acme.com
SES_MAIL_FROM_PREFIX="mail"

# --- inbound worker -> app shared secret (HMAC) ---
INBOUND_WEBHOOK_SECRET="run: openssl rand -hex 32"

# --- Cloudflare R2 (attachments) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="mail-attachments"

