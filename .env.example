# --- Postgres ---
DATABASE_URL="postgres://mail:mail@localhost:5432/mail"

# --- better-auth ---
BETTER_AUTH_SECRET="run: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- GitHub OAuth (the only sign-in method) ---
# Callback URL: <app url>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Amazon SES (outbound) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional: SES configuration set that publishes events to SNS.
SES_CONFIGURATION_SET=""
# Pins the SNS topic allowed to post delivery events.
SES_SNS_TOPIC_ARN=""
# Prefix for the custom MAIL FROM subdomain: mail -> mail.acme.com
SES_MAIL_FROM_PREFIX="mail"
# DKIM selector for keys this app generates: <selector>._domainkey.acme.com
SES_DKIM_SELECTOR="mail"

# --- inbound worker -> app shared secret (HMAC) ---
INBOUND_WEBHOOK_SECRET="run: openssl rand -hex 32"

# --- Cloudflare R2 (attachments) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="mail-attachments"


# --- Housekeeping ---
# The sidebar asks GitHub once every six hours whether a newer release exists.
# Set to off to stop that request; the version it is running still shows.
UPDATE_CHECK=""

# --- Desktop notifications (optional) ---
# Web Push keys, so the browser can be told about mail while Mailroom is shut.
# Generate a pair with: pnpm push:keys
# Without them the Notifications settings page says so and offers nothing.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# How a push service reaches you if this instance misbehaves.
VAPID_SUBJECT="mailto:you@example.com"
